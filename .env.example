# Variables de entorno de modernizate-web. Copiar a .env.local (ignorado por git) y completar ahí.
# Nunca escribir valores reales en este archivo.

# Portal de clientes (/ingresar)
# Ruta ABSOLUTA a un JSON fuera del repositorio con la relación correo → acceso del proyecto:
#   { "correos": { "persona@gmail.com": "https://…" }, "dominios": { "empresa.cl": "https://…" } }
PORTAL_CLIENTES_ARCHIVO=
# Destinos permitidos para redirigir, separados por coma. Si no se define: *.agmodernizate.cl
PORTAL_DESTINOS_PERMITIDOS=
# Cuántos proxies propios agregan X-Forwarded-For (1 = solo Apache; 2 = Cloudflare con proxy + Apache). Por defecto 1.
PORTAL_PROXIES_CONFIABLES=
